# Copy to .env.local (or set in your build environment) and fill in what you need.
# Every variable is optional; leave them empty and the site builds without them.
# They are read at build time, so rebuild after changing them.

# Umami web analytics (https://umami.is). Always on; these override the
# openstatuspage.dev defaults in src/lib/analytics.ts. The tracker only counts
# the hostnames in UMAMI_DOMAINS, so other hosts send nothing.
#
# Base URL of the Umami instance (default: https://analytics.partlabs.de)
UMAMI_URL=
# Website ID from the Umami dashboard
UMAMI_WEBSITE_ID=
# Optional: comma-separated hostnames to count (defaults to openstatuspage.dev)
UMAMI_DOMAINS=

# Google Search Console verification token (content of the google-site-verification meta tag)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification token (content of the msvalidate.01 meta tag).
# ChatGPT search and Copilot use the Bing index.
BING_SITE_VERIFICATION=
