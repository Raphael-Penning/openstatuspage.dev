# Copy to .env.local (or set in your build environment) and fill in what you need.
# Every variable is optional; leave them empty and the site builds without them.
# They are read at build time, so rebuild after changing them.

# Umami web analytics (https://umami.is). Analytics stay off unless both
# UMAMI_URL and UMAMI_WEBSITE_ID are set, so forks and local builds never
# report to someone else's instance. The privacy policy only mentions Umami
# when it is configured.
#
# Base URL of your Umami instance, e.g. https://analytics.example.com
UMAMI_URL=
# Website ID from the Umami dashboard
UMAMI_WEBSITE_ID=
# Optional: comma-separated hostnames to count (defaults to openstatuspage.dev)
UMAMI_DOMAINS=

# Google Search Console verification token (content of the google-site-verification meta tag)
GOOGLE_SITE_VERIFICATION=
